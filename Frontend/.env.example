# Frontend environment variables
# Copy this file to .env.local for local dev, or set in Vercel dashboard.
# All VITE_ vars are embedded at build time. Do NOT put secrets here.

# Node.js chatbot + integrations backend (Render.com)
# Local dev  -> leave empty (Vite proxy handles /api/chat and /api/integrations)
# Staging    -> https://categorizr-chatbot-staging.onrender.com
# Production -> https://categorizr-chatbot.onrender.com
VITE_NODE_API_URL=
