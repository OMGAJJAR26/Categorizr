# Copy to .env and fill in values
# Server
PORT=3000

# Frontend URL (for CORS) - set to your Vercel frontend URL after deploy
FRONTEND_URL=https://your-frontend.vercel.app

# OpenAI (for chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# QuickBooks
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
QB_REDIRECT_URI=

# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# FreshBooks Classic
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
FRESHBOOKS_REDIRECT_URI=
FRESHBOOKS_SCOPES=
FRESHBOOKS_CURRENCY=USD
FRESHBOOKS_STAFF_ID=

# Sage Intacct
SAGE_INTACCT_SENDER_ID=
SAGE_INTACCT_SENDER_PASSWORD=
SAGE_INTACCT_COMPANY_ID=
SAGE_INTACCT_USER_ID=
SAGE_INTACCT_USER_PASSWORD=
